# Copy to .env and adapt for your host. Never expose this demo to the public Internet.
CACHE_MODE=aside
CACHE_TTL_SEC=30
L1_TTL_SEC=1
DB_QUERY_EXTRA_MS=0
DB_POOL_SIZE=12
CACHE_TIMEOUT_SEC=0.15
SEED_ROWS=250000
APP_CPUS=1.0
APP_MEMORY=512m
GATEWAY_PORT=8080
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
PUSHGATEWAY_PORT=9091
# Linux host path used by cAdvisor (Docker info: DockerRootDir).
DOCKER_DATA_ROOT=/var/lib/docker
